# ============================================================================
# Rothenburg Digital – Umgebungsvariablen (Beispiel)
# ----------------------------------------------------------------------------
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# `.env.local` wird durch `.gitignore` ausgeschlossen — echte Secrets NIEMALS
# in `.env.example` eintragen.
# ============================================================================

# ----------------------------------------------------------------------------
# LLM-Provider (Vercel AI SDK) — Issue #12
# ----------------------------------------------------------------------------
# Welcher Anbieter beantwortet die Chat-Anfragen? "anthropic" oder "mistral".
# Ohne Eintrag: anthropic.
#
# Hintergrund: Anthropic bietet Data-Residency nur für "us" und "global" — kein
# EU-Pinning. Mistral ist EU-gehostet (Frankreich). Deshalb kann localhost/dev
# auf Claude bleiben, während staging/prod über Mistral läuft.
#
# Ein unbekannter Wert ist ein Fehler und *kein* Fallback: der Chat antwortet
# dann mit 503, statt still über den falschen Anbieter zu laufen.
# LLM_PROVIDER=anthropic

# --- Anthropic ---------------------------------------------------------------
# API-Key. Erhältlich unter https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: konkretes Modell überschreiben. Standard: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Mistral AI (EU) ---------------------------------------------------------
# API-Key. Erhältlich unter https://console.mistral.ai/
# MISTRAL_API_KEY=

# Optional: konkretes Modell überschreiben. Standard: mistral-large-latest
# MISTRAL_MODEL=mistral-large-latest

# --- Kostenanzeige -----------------------------------------------------------
# Die Preise der gängigen Modelle stehen in src/lib/llm/pricing.ts (Stand
# 07.09.2026). Für ein Modell, das dort fehlt, zeigt die UI bewusst *keine*
# Schätzung — oder es wird hier ein Preis gesetzt (US-Dollar pro 1 Mio. Token):
# LLM_PRICE_INPUT_USD_PER_MTOK=0.5
# LLM_PRICE_OUTPUT_USD_PER_MTOK=1.5

# Wechselkurs USD->EUR in Prozent (92 = 0,92 €). Kein Live-Kurs.
# USD_TO_EUR_PERCENT=92

# ----------------------------------------------------------------------------
# Missbrauchs-Abwehr für /api/chat (Issue #13)
# ----------------------------------------------------------------------------
# Alle Werte sind optional; ohne Eintrag greifen die Defaults aus
# src/lib/guard/config.ts. Sie werden zur Laufzeit gelesen — kein Rebuild.
# Ausführliche Beschreibung: docs/SICHERHEIT-PROMPTS.md

# Not-Aus: schaltet den Chat komplett ab (Antwort 503).
# CHAT_DISABLED=0

# Grenzwerte pro Anfrage
# CHAT_MAX_BODY_BYTES=65536
# CHAT_MAX_USER_CHARS=2000
# CHAT_MAX_HISTORY_MESSAGES=20
# CHAT_MAX_TOTAL_CHARS=12000
# CHAT_MAX_OUTPUT_TOKENS=800

# Rate-Limit und Kontingente pro Gegenstelle
# CHAT_RATE_WINDOW_MS=60000
# CHAT_RATE_MAX_REQUESTS=12
# CHAT_MAX_REQUESTS_PER_DAY=150

# Beim Entwickeln stört das Limit: auf localhost sinnvoll großzügig, z. B.
#   CHAT_RATE_MAX_REQUESTS=60
#   CHAT_SUSPICIOUS_LIMIT=0     # 0 = keine befristeten Sperren
# Auf dev/staging/prod bleiben die Defaults.

# Tages-Token-Budget über alle Nutzer (0 = aus) — Bremse gegen Kostenlawinen.
# CHAT_DAILY_TOKEN_BUDGET=300000

# Befristete Sperre nach wiederholten Angriffsversuchen
# CHAT_SUSPICIOUS_LIMIT=5
# CHAT_SUSPICIOUS_BLOCK_MS=900000

# Origin-Prüfung. Nur setzen, wenn ein Fremdeinbau gewollt ist (Embed-Widget).
# CHAT_ALLOW_ANY_ORIGIN=0
# CHAT_ALLOWED_ORIGINS=https://rothenburg.digital,https://www.rothenburg.de

# Salt für die pseudonymisierten Client-Kennungen im Log. Ohne Wert wird pro
# Prozessstart ein zufälliger benutzt (Pseudonyme dann nicht dauerhaft).
# CHAT_LOG_SALT=

# Prüfmarke im System-Prompt. Nur für Red-Team-Läufe setzen: taucht der Wert
# in einer Antwort auf, wurde der System-Prompt geleakt.
# CHAT_PROMPT_CANARY=

# ----------------------------------------------------------------------------
# Feature-Flags
# ----------------------------------------------------------------------------
# Aktivierung per "1" oder "true". Alles andere = deaktiviert (Default).
# Diese Flags sind mit NEXT_PUBLIC_-Präfix versehen, damit sie sowohl auf dem
# Server als auch im Client-Bundle verfügbar sind.
#
# WICHTIG: Auf Prod bleiben unfertige Tools per Default deaktiviert.
# Nur explizit hier auf "1" setzen, wenn ein Feature freigegeben werden soll.

# Sensor.Community Integration (Feinstaub/Umweltdaten)
NEXT_PUBLIC_FEATURE_SENSOR_COMMUNITY=0

# RTS-Showcase (Rothenburger Tourismus-Service Vorschau)
NEXT_PUBLIC_FEATURE_RTS_SHOWCASE=0
